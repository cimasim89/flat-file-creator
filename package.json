{
  "name": "flat-file-creator",
  "version": "3.0.0",
  "description": "Generate a flat positional text file of your dataset",
  "main": "./dist/flat-file-creator.js",
  "types": "./dist/flat-file-creator.d.ts",
  "scripts": {
    "test": "jest",
    "watch": "jest --watch",
    "lint": "eslint --cache --format codeframe src/*.ts",
    "lint:fix": "eslint --fix --cache --format codeframe src/*.ts",
    "typecheck": "npx tspc --noEmit",
    "prepublishOnly": "tsc",
    "postinstall": "yarn husky install"
  },
  "keywords": [
    "positional",
    "file-generator",
    "flat-file",
    "positional-dataset"
  ],
  "author": "cimasim89",
  "email": "cimasim89@gmail.com",
  "license": "MIT",
  "homepage": "https://github.com/cimasim89/flat-file-creator#readme",
  "repository": "github:cimasim89/flat-file-creator",
  "bugs": {
    "url": "https://github.com/cimasim89/flat-file-creator/issues"
  },
  "dependencies": {
    "date-fns": "4.1.0",
    "date-fns-tz": "3.2.0"
  },
  "devDependencies": {
    "@commitlint/cli": "18.2.0",
    "@commitlint/config-conventional": "18.1.0",
    "@types/jest": "29.5.7",
    "@types/node": "20.8.10",
    "@typescript-eslint/eslint-plugin": "6.10.0",
    "@typescript-eslint/parser": "6.10.0",
    "eslint": "8.53.0",
    "eslint-config-prettier": "9.0.0",
    "eslint-config-standard": "17.1.0",
    "eslint-formatter-codeframe": "7.32.1",
    "eslint-import-resolver-typescript": "3.6.1",
    "eslint-plugin-eslint-plugin": "5.1.1",
    "eslint-plugin-import": "2.29.0",
    "eslint-plugin-jest": "27.6.0",
    "eslint-plugin-node": "11.1.0",
    "eslint-plugin-prettier": "5.0.1",
    "eslint-plugin-promise": "6.1.1",
    "husky": "8.0.3",
    "jest": "29.7.0",
    "prettier": "3.0.3",
    "pretty-quick": "3.1.3",
    "ts-jest": "29.1.1",
    "ts-patch": "3.0.2",
    "typescript": "5.2.2"
  },
  "engines": {
    "node": ">10.0.4"
  },
  "jest": {
    "globalSetup": "./jest-global-setup.js",
    "transform": {
      "^.+\\.tsx?$": "ts-jest"
    },
    "roots": [
      "src/"
    ]
  }
}
