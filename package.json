{
  "name": "flat-file-creator",
  "version": "3.0.2-next.0",
  "description": "Generate a flat positional text file of your dataset",
  "type": "module",
  "main": "./dist/flat-file-creator.js",
  "types": "./dist/flat-file-creator.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "import": "./dist/flat-file-creator.js",
      "types": "./dist/flat-file-creator.d.ts"
    }
  },
  "scripts": {
    "test": "vitest run",
    "watch": "vitest",
    "lint": "eslint src",
    "lint:fix": "eslint --fix src",
    "clean": "rm -rf dist",
    "build": "npm run clean && tsc",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run lint && npm test && npm run build",
    "prepare": "husky"
  },
  "keywords": [
    "positional",
    "file-generator",
    "flat-file",
    "positional-dataset"
  ],
  "author": "cimasim89",
  "email": "cimasim89@gmail.com",
  "license": "MIT",
  "homepage": "https://github.com/cimasim89/flat-file-creator#readme",
  "repository": "github:cimasim89/flat-file-creator",
  "bugs": {
    "url": "https://github.com/cimasim89/flat-file-creator/issues"
  },
  "dependencies": {
    "date-fns": "4.1.0",
    "date-fns-tz": "3.2.0"
  },
  "devDependencies": {
    "@commitlint/cli": "20.5.0",
    "@commitlint/config-conventional": "20.5.0",
    "@types/node": "25.6.0",
    "eslint": "10.2.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.5",
    "husky": "9.1.7",
    "prettier": "3.8.2",
    "pretty-quick": "4.2.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.1",
    "vitest": "4.1.4"
  },
  "peerDependencies": {
    "typescript": ">=4.7"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20"
  }
}
